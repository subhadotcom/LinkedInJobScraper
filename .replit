modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["geckodriver", "openssl", "postgresql", "chromium"]

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run_linkedin_scraper"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --reuse-port --reload main:app"
waitForPort = 5000

[[workflows.workflow]]
name = "run_linkedin_scraper"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --keywords \"python developer\" --location \"remote\" --pages 1 --verbose"

[[ports]]
localPort = 5000
externalPort = 80
